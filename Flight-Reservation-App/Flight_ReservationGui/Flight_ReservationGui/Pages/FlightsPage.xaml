<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Flight_ReservationGui.Pages.FlightsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    Loaded="Page_Loaded">

    <Grid Padding="32,24,32,32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="&#xE709;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Text="Flight Management" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <!-- InfoBar for messages -->
        <InfoBar x:Name="StatusInfoBar" Grid.Row="1" IsOpen="False" Severity="Informational" />

        <!-- Input Form -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8" Padding="24" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="16">
                <TextBlock Text="Flight Details" FontSize="18" FontWeight="SemiBold" />

                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox x:Name="TxtFlightId" Header="Flight ID" PlaceholderText="Auto-generated"
                             IsEnabled="False" Grid.Column="0" Grid.Row="0" />
                    <TextBox x:Name="TxtFlightNumber" Header="Flight Number *" PlaceholderText="e.g. SV-1234"
                             Grid.Column="1" Grid.Row="0" />
                    <TextBox x:Name="TxtDistanceKm" Header="Distance (KM)" PlaceholderText="e.g. 1500.50"
                             Grid.Column="2" Grid.Row="0" />
                    <ComboBox x:Name="CmbStatus" Header="Status *" PlaceholderText="Select Status"
                              Grid.Column="3" Grid.Row="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Scheduled" />
                        <ComboBoxItem Content="Delayed" />
                        <ComboBoxItem Content="Cancelled" />
                        <ComboBoxItem Content="Landed" />
                        <ComboBoxItem Content="In Air" />
                    </ComboBox>

                    <ComboBox x:Name="CmbAircraft" Header="Aircraft" PlaceholderText="Select Aircraft"
                              DisplayMemberPath="Model" Grid.Column="0" Grid.Row="1" HorizontalAlignment="Stretch" />
                    <ComboBox x:Name="CmbDepartureAirport" Header="Departure Airport *" PlaceholderText="Select Airport"
                              Grid.Column="1" Grid.Row="1" HorizontalAlignment="Stretch" />
                    <ComboBox x:Name="CmbArrivalAirport" Header="Arrival Airport *" PlaceholderText="Select Airport"
                              Grid.Column="2" Grid.Row="1" HorizontalAlignment="Stretch" />

                    <CalendarDatePicker x:Name="DpDeparture" Header="Departure Date *" PlaceholderText="Pick date"
                                        Grid.Column="0" Grid.Row="2" HorizontalAlignment="Stretch" />
                    <TimePicker x:Name="TpDeparture" Header="Departure Time *"
                                Grid.Column="1" Grid.Row="2" HorizontalAlignment="Stretch" />
                    <CalendarDatePicker x:Name="DpArrival" Header="Arrival Date *" PlaceholderText="Pick date"
                                        Grid.Column="2" Grid.Row="2" HorizontalAlignment="Stretch" />
                    <TimePicker x:Name="TpArrival" Header="Arrival Time *"
                                Grid.Column="3" Grid.Row="2" HorizontalAlignment="Stretch" />
                </Grid>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="🔄 Refresh" Click="Btn_Refresh_Click" />
                    <Button Content="✖ Clear" Click="Btn_Clear_Click" />
                    <Button x:Name="BtnAdd" Content="➕ Add Flight" Style="{StaticResource AccentButtonStyle}" Click="Btn_Add_Click" />
                    <Button x:Name="BtnUpdate" Content="✏️ Update" Click="Btn_Update_Click" />
                    <Button x:Name="BtnDelete" Content="🗑️ Delete" Click="Btn_Delete_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Data ListView -->
        <Border Grid.Row="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8" Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <ListView x:Name="FlightsListView" SelectionChanged="FlightsListView_SelectionChanged"
                      SelectionMode="Single">
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid Padding="8,12" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ID" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="Flight #" FontWeight="Bold" />
                            <TextBlock Grid.Column="2" Text="Distance" FontWeight="Bold" />
                            <TextBlock Grid.Column="3" Text="Status" FontWeight="Bold" />
                            <TextBlock Grid.Column="4" Text="Aircraft" FontWeight="Bold" />
                            <TextBlock Grid.Column="5" Text="Dep. Airport" FontWeight="Bold" />
                            <TextBlock Grid.Column="6" Text="Departure" FontWeight="Bold" />
                            <TextBlock Grid.Column="7" Text="Arr. Airport" FontWeight="Bold" />
                            <TextBlock Grid.Column="8" Text="Arrival" FontWeight="Bold" />
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding FlightId}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding FlightNumber}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding DistanceKm}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding Status}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding AircraftModel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="5" Text="{Binding DepartureAirportName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="6" Text="{Binding DepartureTime}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="7" Text="{Binding ArrivalAirportName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="8" Text="{Binding ArrivalTime}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
